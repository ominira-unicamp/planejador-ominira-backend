generator client {
  provider            = "prisma-client"
  output              = "./generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "./generated/zod"
  config   = "./config-zod.json"
}

generator dbml {
  provider = "prisma-dbml-generator"
}

datasource db {
  provider = "postgresql"
}

enum YearPeriods {
  SUMMER
  FIRST_SEMESTER
  WINTER
  SECOND_SEMESTER
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  name  String
}

enum AuthUserStatus {
  ACTIVE
  DISABLED
}

enum AuthRole {
  STUDENT
  BOT
  ADMIN
}

enum Capability {
  ACADEMIC_WRITE
}

enum StudentCapability {
  STUDENT_PROFILE_READ
  STUDENT_PROFILE_WRITE
  STUDENT_HISTORY_READ
  STUDENT_HISTORY_WRITE
  STUDENT_PLANNING_READ
  STUDENT_PLANNING_WRITE
}

model AuthUser {
  id          Int            @id @default(autoincrement())
  issuer      String
  subject     String
  email       String?
  displayName String?
  status      AuthUserStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  roles        AuthUserRole[]
  capabilities AuthUserCapability[]
  student      Student?
  botGrants    BotGrant[] @relation("BotGrantBot")
  grantsGiven  BotGrant[] @relation("BotGrantGrantedBy")
  grantsRevoked BotGrant[] @relation("BotGrantRevokedBy")

  @@unique([issuer, subject])
}

model AuthUserRole {
  authUser   AuthUser @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  authUserId Int
  role       AuthRole

  @@id([authUserId, role])
}

model AuthUserCapability {
  authUser   AuthUser   @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  authUserId Int
  capability Capability

  @@id([authUserId, capability])
}

// ----------------------- Academic Models ----------------------- //

model Unit {
  id       Int        @id @default(autoincrement())
  code     String     @unique
  courses  Course[]
  prefixes Prefixes[]
  programs Program[]
}

model Prefixes {
  id     Int    @id @default(autoincrement())
  prefix String @unique
  unit   Unit   @relation(fields: [unitId], references: [id])
  unitId Int

  courseRequirements CourseRequirement[]
  courses            Course[]
}

model Course {
  id       Int       @id @default(autoincrement())
  code     String    @unique
  name     String
  credits  Int
  unit     Unit      @relation(fields: [unitId], references: [id])
  unitId   Int
  prefix   Prefixes? @relation(fields: [prefixId], references: [id])
  prefixId Int?

  classes            Class[]
  studentCourses     StudentCourse[]
  curriculumCourses  CurriculumCourse[]
  courseRequirements CourseRequirement[]
  suggestionCourses  SuggestionCourse[]
}

// ----------------------- Programs Catalog Models ----------------------- //

model Catalog {
  id       Int              @id @default(autoincrement())
  year     Int
  programs CatalogProgram[]

  students Student[]
}

model Program {
  id              Int              @id @default(autoincrement())
  code            Int              @unique
  name            String
  unit            Unit             @relation(fields: [unitId], references: [id])
  unitId          Int
  catalogPrograms CatalogProgram[]
  specializations Specialization[]
  students        Student[]
}

model Specialization {
  id        Int       @id @default(autoincrement())
  program   Program   @relation(fields: [programId], references: [id])
  programId Int
  code      String
  name      String
  students  Student[]

  catalogSpecializations CatalogSpecialization[]

  @@unique([programId, code])
}

model Language {
  id               Int               @id @default(autoincrement())
  name             String
  catalogLanguages CatalogLanguage[]
}

model CatalogProgram {
  id                     Int                     @id @default(autoincrement())
  catalog                Catalog                 @relation(fields: [catalogId], references: [id])
  catalogId              Int
  program                Program                 @relation(fields: [programId], references: [id])
  programId              Int
  catalogSpecializations CatalogSpecialization[]
  catalogLanguages       CatalogLanguage[]
  courseBlocks           CourseBlock[]
  curriculumSuggestions  CurriculumSuggestion[]
  curricula               Curriculum[]

  @@unique([catalogId, programId])
}

model CatalogSpecialization {
  id               Int            @id @default(autoincrement())
  catalogProgram   CatalogProgram @relation(fields: [catalogProgramId], references: [id], onDelete: Cascade)
  catalogProgramId Int
  specialization   Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)
  specializationId Int

  courseBlocks         CourseBlock[]
  curriculumSuggestion CurriculumSuggestion?
  curricula             Curriculum[]

  @@unique([catalogProgramId, specializationId])
}

enum CurriculumSuggestionType {
  GENERAL
  SPECIALIZATION
  PRE_OPTION
}

model CatalogLanguage {
  id               Int            @id @default(autoincrement())
  catalogProgram   CatalogProgram @relation(fields: [catalogProgramId], references: [id], onDelete: Cascade)
  catalogProgramId Int
  language         Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)
  languageId       Int
  courseBlocks     CourseBlock[]
  curricula        Curriculum[]

  @@unique([catalogProgramId, languageId])
}

model CurriculumSuggestion {
  id                      Int                      @id @default(autoincrement())
  catalogProgram          CatalogProgram           @relation(fields: [catalogProgramId], references: [id], onDelete: Cascade)
  catalogProgramId        Int
  code                    String
  name                    String
  type                    CurriculumSuggestionType @default(GENERAL)
  catalogSpecialization   CatalogSpecialization?   @relation(fields: [catalogSpecializationId], references: [id])
  catalogSpecializationId Int?                     @unique
  semesters               SemesterSuggestion[]

  @@unique([catalogProgramId, code])
}

model SemesterSuggestion {
  id              Int                  @id @default(autoincrement())
  suggestion      CurriculumSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  suggestionId    Int
  semester        Int
  electiveCredits Int                  @default(0)
  courses         SuggestionCourse[]

  @@unique([suggestionId, semester])
}

model SuggestionCourse {
  id                   Int                @id @default(autoincrement())
  semesterSuggestion   SemesterSuggestion @relation(fields: [semesterSuggestionId], references: [id], onDelete: Cascade)
  semesterSuggestionId Int
  course               Course             @relation(fields: [courseId], references: [id])
  courseId             Int

  @@unique([semesterSuggestionId, courseId])
}

// ----------------------- Course Requirements Models ----------------------- //

enum CourseBlockType {
  mandatory
  elective
}

enum CourseRequirementType {
  any
  prefix
  specific
}

model CourseBlock {
  id      Int             @id @default(autoincrement())
  type    CourseBlockType
  credits Int?

  catalogLanguage   CatalogLanguage? @relation(fields: [catalogLanguageId], references: [id], onDelete: Cascade)
  catalogLanguageId Int?

  catalogSpecialization   CatalogSpecialization? @relation(fields: [catalogSpecializationId], references: [id], onDelete: Cascade)
  catalogSpecializationId Int?

  catalogProgram   CatalogProgram? @relation(fields: [catalogProgramId], references: [id], onDelete: Cascade)
  catalogProgramId Int?

  courseRequirements CourseRequirement[]
}

model CourseRequirement {
  id            Int                   @id @default(autoincrement())
  courseBlock   CourseBlock           @relation(fields: [courseBlockId], references: [id], onDelete: Cascade)
  courseBlockId Int
  type          CourseRequirementType
  course        Course?               @relation(fields: [courseId], references: [id])
  courseId      Int?
  prefix        Prefixes?             @relation(fields: [prefixId], references: [id])
  prefixId      Int?
}

// ----------------------- Timetable Booklet Models ----------------------- //

model StudyPeriod {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  startDate       DateTime
  classes         Class[]
  periodPlannings PeriodPlanning[]
}

model Professor {
  id      Int     @id @default(autoincrement())
  name    String
  classes Class[]
}

model Room {
  id             Int             @id @default(autoincrement())
  code           String          @unique
  classSchedules ClassSchedule[]
}

model Class {
  id            Int         @id @default(autoincrement())
  code          String
  studyPeriod   StudyPeriod @relation(fields: [studyPeriodId], references: [id])
  studyPeriodId Int
  course        Course      @relation(fields: [courseId], references: [id])
  courseId      Int
  reservations  Int[]

  professors      Professor[]
  classSchedules  ClassSchedule[]
  periodPlannings PeriodPlanning[]
}

//  Sim é um Enum para dias das semanas, não é melhor coisa, mas quis assim. 
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model ClassSchedule {
  id        Int       @id @default(autoincrement())
  dayOfWeek DayOfWeek
  start     String
  end       String
  room      Room      @relation(fields: [roomId], references: [id])
  roomId    Int
  class     Class     @relation(fields: [classId], references: [id])
  classId   Int
}

// ----------------------- Student Models ----------------------- //

enum StudentCourseStatus {
  ENROLLED
  COMPLETED
  DROPPED
}

model Student {
  id               Int             @id @default(autoincrement())
  ra               String          @unique
  name             String
  authUser         AuthUser?       @relation(fields: [authUserId], references: [id])
  authUserId       Int?            @unique
  program          Program?        @relation(fields: [programId], references: [id])
  programId        Int?
  specialization   Specialization? @relation(fields: [specializationId], references: [id])
  specializationId Int?
  catalog          Catalog?        @relation(fields: [catalogId], references: [id])
  catalogId        Int?

  courses         StudentCourse[]
  periodPlannings PeriodPlanning[]
  curriculums     Curriculum[]
  botGrants       BotGrant[]
}

model BotGrant {
  id                  Int               @id @default(autoincrement())
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId           Int
  botAuthUser         AuthUser          @relation("BotGrantBot", fields: [botAuthUserId], references: [id], onDelete: Cascade)
  botAuthUserId       Int
  capability          StudentCapability
  grantedByAuthUser   AuthUser          @relation("BotGrantGrantedBy", fields: [grantedByAuthUserId], references: [id])
  grantedByAuthUserId Int
  createdAt           DateTime          @default(now())
  revokedAt           DateTime?
  revokedByAuthUser   AuthUser?         @relation("BotGrantRevokedBy", fields: [revokedByAuthUserId], references: [id])
  revokedByAuthUserId Int?

  @@index([studentId, botAuthUserId, capability, revokedAt])
}

model StudentCourse {
  student   Student             @relation(fields: [studentId], references: [id])
  studentId Int
  course    Course              @relation(fields: [courseId], references: [id])
  courseId  Int
  status    StudentCourseStatus

  @@id([studentId, courseId])
}

model Curriculum {
  id                      Int                    @id @default(autoincrement())
  student                 Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId               Int
  name                    String                 @default("Novo planejamento")
  catalogProgram          CatalogProgram?        @relation(fields: [catalogProgramId], references: [id])
  catalogProgramId        Int?
  catalogSpecialization   CatalogSpecialization? @relation(fields: [catalogSpecializationId], references: [id])
  catalogSpecializationId Int?
  catalogLanguage         CatalogLanguage?       @relation(fields: [catalogLanguageId], references: [id])
  catalogLanguageId       Int?
  planningStartYear       Int?
  planningStartSemester   Int?
  planningStartNumber     Int?
  currentPeriod           CurriculumPeriod?      @relation("CurrentPeriod", fields: [currentPeriodId], references: [id], onDelete: SetNull)
  currentPeriodId         Int?
  periods                 CurriculumPeriod[]
  courses                 CurriculumCourse[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([studentId, updatedAt])
}

model CurriculumCourse {
  curriculum   Curriculum        @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  curriculumId Int
  course       Course            @relation(fields: [courseId], references: [id])
  courseId     Int
  period       CurriculumPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  periodId     Int?

  @@id([curriculumId, courseId])
  @@index([curriculumId, periodId])
}

model CurriculumPeriod {
  id           Int                @id @default(autoincrement())
  curriculum   Curriculum         @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  curriculumId Int
  position     Int
  courses      CurriculumCourse[]
  currentForCurricula Curriculum[] @relation("CurrentPeriod")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([curriculumId, position])
}

model PeriodPlanning {
  id            Int         @id @default(autoincrement())
  studyPeriod   StudyPeriod @relation(fields: [studyPeriodId], references: [id])
  studyPeriodId Int
  student       Student     @relation(fields: [studentId], references: [id])
  studentId     Int

  classes Class[]
}

model CalendarEvent {
  id          Int           @id @default(autoincrement())
  startDate   DateTime
  endDate     DateTime?
  description String
  tags        CalendarTag[]

  @@index([startDate, endDate])
}

model CalendarTag {
  id     Int             @id @default(autoincrement())
  name   String          @unique
  events CalendarEvent[]
}
