{
    "name": "@pomi/notifier",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": {
            "development": "./src/*",
            "default": "./dist/src/*"
        }
    },
    "scripts": {
        "dev": "NODE_OPTIONS=--conditions=development tsx watch src/cli.ts",
        "build": "tsc -b",
        "start": "node dist/src/cli.js",
        "test": "NODE_OPTIONS=--conditions=development tsx --test test/**/*.test.ts"
    },
    "dependencies": {
        "@pomi/db": "*",
        "dotenv": "^17.2.3",
        "jose": "^6.1.3",
        "nodemailer": "^7.0.10",
        "pino": "^10.3.1",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@types/nodemailer": "^6.4.19"
    }
}
