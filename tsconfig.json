{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#/scripts/*": ["scripts/*"],
      "#/*": ["src/*"]
    },
    "sourceMap": true,
    "outDir": "dist",
    "strict": true,
    "lib": [
      "esnext"
    ],
    "esModuleInterop": true,
    "module": "nodenext",
    "target": "es6", 
    "resolveJsonModule": true
  }
}
